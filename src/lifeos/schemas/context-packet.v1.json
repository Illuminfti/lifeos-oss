{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeos.dev/schemas/context-packet.v1.json",
  "title": "LifeOS turn context packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "purpose",
    "as_of",
    "current_facts",
    "recent_changes",
    "open_loops",
    "constraints",
    "evidence",
    "coverage",
    "digest",
    "not_modified"
  ],
  "properties": {
    "schema": {"const": "lifeos.turn-context/v1"},
    "purpose": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "current_facts": {"type": "array", "items": {"type": "object"}},
    "recent_changes": {"type": "array", "items": {"type": "object"}},
    "open_loops": {"type": "array", "items": {"type": "object"}},
    "constraints": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "coverage": {"type": "object"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "not_modified": {"type": "boolean"}
  }
}
